{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/reference/",
  "preferredVersions": {
    "php": "7.4",
    "wp": "latest"
  },
  "phpExtensionBundles": [
    "kitchen-sink"
  ],
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "login"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "GatherPress devhub",
        "blogdescription": "Powering Developers using GatherPress.",
        "permalink_structure": "/%year%/%monthnum%/%postname%/"
      }
    },
    {
      "step": "installPlugin",
      "pluginZipFile": {
        "resource": "wordpress.org/plugins",
        "slug": "gatherpress"
      },
      "options": {
        "activate": false
      }
    },
    {
      "step": "installPlugin",
      "pluginZipFile": {
        "resource": "url",
        "url": "https://github-proxy.com/proxy/?repo=GatherPress/gatherpress-alpha&branch=main"
      },
      "options": {
        "activate": false
      }
    },
    {
      "step": "installPlugin",
      "pluginZipFile": {
        "resource": "wordpress.org/plugins",
        "slug": "uncomment"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginZipFile": {
        "resource": "wordpress.org/plugins",
        "slug": "code-syntax-block"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wporg-mu-plugins.zip",
      "data": {
        "resource": "url",
        "url": "https://github-proxy.com/proxy/?repo=WordPress/wporg-mu-plugins&branch=build&directory=mu-plugins",
        "caption": "Downloading wporg-mu-plugins."
      },
      "progress": {
        "weight": 2,
        "caption": "Applying wporg-mu-plugins."
      }
    },
    {
      "step": "unzip",
      "zipFile": {
        "resource": "vfs",
        "path": "/wordpress/wporg-mu-plugins.zip"
      },
      "extractToPath": "/wordpress/wp-content"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/loader.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/carstingaxion/gatherpress-devhub/WIP/use-build-deps/wp-content/mu-plugins/overwrites-wporg-muplugins-loader.php"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/gatherpress_loader.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/carstingaxion/gatherpress-devhub/WIP/use-build-deps/wp-content/mu-plugins/gatherpress_loader.php"
      }
    },
    {
      "step": "installTheme",
      "themeZipFile": {
        "resource": "url",
        "url": "https://github-proxy.com/proxy/?repo=WordPress/wporg-parent-2021&branch=build"
      },
      "options": {
        "activate": false
      }
    },
    {
      "step": "mv",
      "fromPath": "/wordpress/wp-content/themes/wporg-parent-2021-build",
      "toPath": "/wordpress/wp-content/themes/wporg-parent-2021"
    },
    {
      "step": "installTheme",
      "themeZipFile": {
        "resource": "url",
        "url": "https://github-proxy.com/proxy/?repo=WordPress/wporg-developer&branch=build"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/themes/wporg-developer-build/inc/template-tags.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/carstingaxion/gatherpress-devhub/WIP/use-build-deps/wp-content/themes/wporg-developer-2023/inc/template-tags.php"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/themes/wporg-developer-build/src/code-source/block.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/carstingaxion/gatherpress-devhub/WIP/use-build-deps/wp-content/themes/wporg-developer-2023/src/code-source/block.php"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/phpdoc-parser.zip",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/carstingaxion/gatherpress-devhub/WIP/use-build-deps/zips/phpdoc-parser.zip",
        "caption": "Downloading phpdoc-parser."
      },
      "progress": {
        "weight": 2,
        "caption": "Applying phpdoc-parser."
      }
    },
    {
      "step": "unzip",
      "zipFile": {
        "resource": "vfs",
        "path": "/wordpress/phpdoc-parser.zip"
      },
      "extractToPath": "/wordpress"
    },
    {
      "step": "wp-cli",
      "command": "wp plugin activate phpdoc-parser"
    },
    {
      "step": "installPlugin",
      "pluginZipFile": {
        "resource": "wordpress.org/plugins",
        "slug": "posts-to-posts"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "wp-cli",
      "command": "wp rewrite flush"
    },
    {
      "step": "wp-cli",
      "command": "wp parser create '/wordpress/wp-content/plugins/gatherpress' --user=1"
    },
    {
      "step": "wp-cli",
      "command": "wp parser create '/wordpress/wp-content/plugins/gatherpress-alpha-main' --user=1"
    },
    {
      "step": "wp-cli",
      "command": "wp post update 2 --post_name=reference --post_title=Reference"
    }
  ]
}
